  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:firebase": "concurrently -k -n emu,web -c magenta,cyan \"npm run emulators\" \"npm run dev\"",
    "emulators": "firebase emulators:start --project demo-mylocalvoice",
    "seed:admin": "node scripts/seed-admin.mjs",
    "verify:firebase": "node scripts/verify-firebase.mjs && node scripts/verify-client-flow.mjs",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,storage",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync": "git pull origin main",
    "finish": "node scripts/finish-work.mjs"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.26.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }

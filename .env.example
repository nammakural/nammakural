# Copy to .env (already done for emulator local setup)
#
# --- Option A: Local emulators (default in this project) ---
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mylocalvoice.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mylocalvoice
VITE_FIREBASE_STORAGE_BUCKET=demo-mylocalvoice.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:nammakural
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_VILLAGE_ID=thiruppair
VITE_USE_MOCK_DATA=false
VITE_USE_FIREBASE_EMULATOR=true

# --- Option B: Real Firebase cloud (mylocalvoice-a73f4) ---
# Get keys: Console → Project settings → Your apps → SDK setup
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=mylocalvoice-a73f4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mylocalvoice-a73f4
VITE_FIREBASE_STORAGE_BUCKET=mylocalvoice-a73f4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_VILLAGE_ID=thiruppair
VITE_USE_MOCK_DATA=false
VITE_USE_FIREBASE_EMULATOR=false

# Optional local emulator overrides (set true only for npm run emulators)
# VITE_USE_FIREBASE_EMULATOR=true
